{
  "$schema": "https://opencode.ai/config.json",
  // 工单 08（ADR-032）：默认加载 omos-jx 插件（dev 场景）。
  // 相对路径相对本配置文件目录（.opencode/）解析 → ../../oh-my-opencode-slim → monorepo 根。
  // 注：fork 根 /opencode.json 被 .gitignore 排除，故声明放在本 .opencode/opencode.jsonc。
  "plugin": ["../../oh-my-opencode-slim"],
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
